[Desktop Entry]
Version=1.0
Type=Application
Name=Mast
GenericName=Web Browser
Comment=A deep-work browser
Exec=/opt/mast/chrome %U
Icon=mast
Terminal=false
StartupNotify=true
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=/opt/mast/chrome --new-window
