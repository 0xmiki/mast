# Mast's updates for zypper, installed by the mast package (packaging/package.sh). zypper
# checks the signed metadata and the signed packages against the key the package imported
# into rpm (/etc/pki/rpm-gpg/RPM-GPG-KEY-mast).
[mast]
name=Mast
baseurl=@PAGES@/rpm
type=rpm-md
enabled=1
autorefresh=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-mast
