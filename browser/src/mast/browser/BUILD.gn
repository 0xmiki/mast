# Copyright 2026 The Mast Authors
# Mast's browser-side code. Depends only on small, standalone Chromium targets,
# so upstream targets can depend on it without circular includes.

source_set("browser") {
  sources = [
    "mast_blocklist.cc",
    "mast_blocklist.h",
    "mast_blocks.cc",
    "mast_blocks.h",
    "mast_navigation_throttle.cc",
    "mast_navigation_throttle.h",
    "mast_pages.cc",
    "mast_pages.h",
    "mast_prefs.cc",
    "mast_prefs.h",
    "mast_scheme.cc",
    "mast_scheme.h",
    "mast_theme.h",
  ]
  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/common:constants",
    "//components/pref_registry",
    "//components/prefs",
    "//content/public/browser",
    "//content/public/common",
    "//net",
    "//services/network/public/mojom",
    "//skia",
    "//ui/color",
    "//ui/native_theme",
    "//url",
  ]
}
