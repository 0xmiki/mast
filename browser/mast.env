# Builder settings (Hetzner Cloud; prices are USD, 0% VAT on this account).
MAST_NAME=mast-builder
MAST_LOCATION=${MAST_LOCATION:-hel1}
# cpx51: 16 shared vCPU, 32 GB, 360 GB disk, $0.134/h. ~4x cheaper per core than ccx63 ($1.61/h).
MAST_TYPE=${MAST_TYPE:-cpx51}
MAST_BUDGET=5.00                 # USD for the whole project; ./mast refuses to start past 90%
MAST_SNAPSHOT_USD_GB_MONTH=0.0199
MAST_IDLE_MINUTES=30             # local guard deletes an idle builder after this (see ./mast hold)
MAST_KEY="$HOME/.ssh/mast-builder"
