# Builder settings. Change, then re-run the command that uses them.
MAST_REGION=${MAST_REGION:-us-east-1}
MAST_NAME=mast-builder
# The very first build compiles everything: use a big machine, then resize down.
MAST_BIG_TYPE=${MAST_BIG_TYPE:-c7a.48xlarge}    # 192 vCPU, ~$9.85/h on-demand
MAST_SMALL_TYPE=${MAST_SMALL_TYPE:-c7a.16xlarge}  # 64 vCPU,  ~$3.28/h on-demand — fine for incremental builds
MAST_DISK_GB=300               # kept between builds; ~$29/month while stopped (gp3 + 250 MB/s)
MAST_IDLE_MINUTES=20           # builder shuts itself down after this long with nothing running
MAST_KEY="$HOME/.ssh/mast-builder"
