# Builder settings (Hetzner Cloud; prices are USD, 0% VAT on this account).
MAST_NAME=mast-builder
MAST_LOCATION=${MAST_LOCATION:-hel1}
# cpx62: 16 shared AMD vCPU, 32 GB, 640 GB disk, $0.245/h in EU. ~3.3x cheaper per core than ccx63 ($1.61/h).
MAST_TYPE=${MAST_TYPE:-cpx62}
MAST_BUDGET=8.00                 # USD for the whole project; ./mast refuses to start past 90%
MAST_SNAPSHOT_USD_GB_MONTH=0.0199
MAST_IDLE_MINUTES=30             # local guard deletes an idle builder after this (see ./mast hold)
MAST_KEY="$HOME/.ssh/mast-builder"
# Where testers download builds from (./mast package bakes it into install.sh). Must serve
# the files in dist/release/ under these exact names, e.g. a GitHub release's "latest" link.
MAST_DOWNLOAD_URL=${MAST_DOWNLOAD_URL:-https://github.com/0xmiki/mast-releases/releases/latest/download}
